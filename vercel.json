{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/auth/register",
      "methods": ["POST", "GET", "OPTIONS"],
      "dest": "/api/auth/register.js"
    },
    {
      "src": "/api/register",
      "methods": ["POST", "GET", "OPTIONS"],
      "dest": "/api/register.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/client/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "/client/index.html"
    }
  ]
}